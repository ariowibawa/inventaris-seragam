// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  address   String?
  purchases Purchase[]

  @@map("suppliers")
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  categoryId   String   @map("category_id")
  size         String
  color        String
  costPrice    Int      @map("cost_price")
  sellingPrice Int      @map("selling_price")
  stock        Int      @default(0)
  minimumStock Int      @default(15) @map("minimum_stock")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  purchaseItems  PurchaseItem[]
  salesItems     SalesItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique @map("purchase_number")
  supplierId     String         @map("supplier_id")
  purchaseDate   DateTime       @map("purchase_date")
  totalAmount    Int            @map("total_amount")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseItems PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String @map("purchase_id")
  productId  String @map("product_id")
  quantity   Int
  costPrice  Int    @map("cost_price")
  subtotal   Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model Sale {
  id            String      @id @default(cuid())
  salesNumber   String      @unique @map("sales_number")
  salesDate     DateTime    @map("sales_date")
  totalAmount   Int         @map("total_amount")
  discount      Int         @default(0)
  paymentMethod String      @map("payment_method")
  totalHpp      Int         @map("total_hpp")
  grossProfit   Int         @map("gross_profit")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  salesItems SalesItem[]

  @@map("sales")
}

model SalesItem {
  id           String @id @default(cuid())
  saleId       String @map("sale_id")
  productId    String @map("product_id")
  quantity     Int
  sellingPrice Int    @map("selling_price")
  costPrice    Int    @map("cost_price")
  discount     Int    @default(0)
  subtotal     Int
  profit       Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sales_items")
}

model StockMovement {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  type           String   // "in" | "out" | "adjustment"
  referenceType  String?  @map("reference_type") // "purchase" | "sale" | "manual"
  referenceId    String?  @map("reference_id")
  quantityBefore Int      @map("quantity_before")
  quantityChange Int      @map("quantity_change")
  quantityAfter  Int      @map("quantity_after")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model Cashflow {
  id           String   @id @default(cuid())
  type         String   // "income" | "expense"
  category     String
  sourceType   String?  @map("source_type") // "sale" | "purchase" | "manual"
  sourceId     String?  @map("source_id")
  amount       Int
  cashflowDate DateTime @map("cashflow_date")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("cashflows")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model PaymentMethod {
  id   String @id @default(cuid())
  name String @unique

  @@map("payment_methods")
}

model CashflowCategory {
  id   String @id @default(cuid())
  name String @unique
  type String // "income" | "expense"

  @@map("cashflow_categories")
}
